Bootstrap: docker
From: shipai/boa-cli

# ---------------------------------------------------------------------------
# MUSIQ BOA image, patched for Apptainer + --nv on newer-glibc hosts.
#
# Problem: `apptainer exec --nv` binds the HOST GL libraries (incl.
# libGLdispatch.so.0) into the container. On a host with glibc >= 2.38 those
# libs require GLIBC_2.38, which the stock boa-cli image (Ubuntu 20.04 /
# glibc 2.31) does not have. BOA then dies at *import* time via the chain:
#     totalsegmentator/nnunet.py
#       -> totalsegmentator/preview.py
#         -> fury -> vtkmodules.*OpenGL2 -> libGLdispatch.so.0  (GLIBC_2.38)
# with: ImportError: ... version `GLIBC_2.38' not found ...
#
# Fix: MUSIQ never consumes TotalSegmentator's preview PNG (it reads the
# xlsx / JSON / NIfTI outputs and runs with --bca-no-pdf), so we replace every
# vendored `totalsegmentator/preview.py` with a fury/OpenGL-free stub. The
# stub keeps the module importable and turns `generate_preview` (and any other
# symbol imported from it) into a no-op, breaking the OpenGL import chain.
# ---------------------------------------------------------------------------

%post
    set -eu

    # Locate every totalsegmentator/preview.py shipped in the image (BOA
    # vendors its own copy under body_organ_analysis/_external/, and there may
    # also be a top-level install). Patch all of them.
    python3 - <<'PY'
import glob, os, sys

STUB = '''\
"""OpenGL/fury-free stub installed by MUSIQ's boa-cli.def.

The original module imported ``fury`` (VTK OpenGL), which crashes at import
time under ``apptainer --nv`` on glibc>=2.38 hosts. MUSIQ does not use the
TotalSegmentator preview image, so every attribute resolves to a no-op.
"""

def _noop(*args, **kwargs):
    return None

# PEP 562: satisfies `from totalsegmentator.preview import <anything>`.
def __getattr__(name):
    return _noop
'''

roots = set()
for p in sys.path:
    if p and os.path.isdir(p):
        roots.add(p)
# Common dist-packages locations, in case they aren't on sys.path yet.
roots.update(glob.glob("/usr/local/lib/python3*/dist-packages"))
roots.update(glob.glob("/usr/lib/python3*/dist-packages"))

patched = []
for root in roots:
    for f in glob.glob(os.path.join(root, "**", "totalsegmentator", "preview.py"), recursive=True):
        with open(f, "w") as fh:
            fh.write(STUB)
        patched.append(f)

if not patched:
    print("WARNING: no totalsegmentator/preview.py found to patch", file=sys.stderr)
else:
    for f in sorted(set(patched)):
        print("patched:", f)
PY

    # Fail the build early if the OpenGL import chain still fires.
    python3 -c "import body_organ_analysis" \
        && echo "OK: body_organ_analysis imports without OpenGL/fury"

%labels
    org.musiq.patch "preview.py stubbed to avoid fury/OpenGL under apptainer --nv"

%help
    BOA CLI image patched for MUSIQ on HPC (Apptainer + --nv, glibc>=2.38 hosts).
    Run via MUSIQ:  musiq --tasks boa --boa-runtime apptainer --boa-sif boa-cli.sif ...
    Or directly:    apptainer exec --nv --bind <study>:/workspace boa-cli.sif \
                      python -m body_organ_analysis --input-image /workspace/CT.nii.gz \
                      --output-dir /workspace/boa --models total+bca --device gpu
